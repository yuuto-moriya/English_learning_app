# 環境変数の例
# - ローカル（vercel dev）: このファイルを .env.local にコピーして値を入れる（.env.local は .gitignore 済み）
#     cp .env.example .env.local
# - 本番（Vercel）: Project → Settings → Environment Variables に登録（Sensitive を推奨）し、Redeploy
# 手順の詳細: docs/SETUP_AZURE.md

# ── Azure AI Translator（翻訳） ──
AZURE_TRANSLATOR_KEY="your-translator-key"
# リソースを作成したリージョン（例: japaneast）。グローバルリソースの場合は global
AZURE_TRANSLATOR_REGION="japaneast"
# 任意。既定は https://api.cognitive.microsofttranslator.com
# AZURE_TRANSLATOR_ENDPOINT="https://api.cognitive.microsofttranslator.com"

# ── Azure AI Speech（発音評価・音声入力） ──
AZURE_SPEECH_KEY="your-speech-key"
AZURE_SPEECH_REGION="japaneast"
# 任意。指定するとリージョンより優先（カスタムサブドメインのエンドポイント）
# AZURE_SPEECH_ENDPOINT="https://<resource>.cognitiveservices.azure.com"

# ── AI 会話（/api/chat。どちらか一方でも動く。両方あれば Cloudflare → Groq の順に試す） ──
# 手順の詳細: docs/SETUP_AI.md。どちらもクレジットカードを登録しない無料プランで使う
# CLOUDFLARE_ACCOUNT_ID="your-account-id"
# CLOUDFLARE_AI_TOKEN="your-workers-ai-token"
# CLOUDFLARE_MODEL="@cf/meta/llama-3.1-8b-instruct-fp8-fast"
# GROQ_API_KEY="gsk_..."
# GROQ_MODEL="openai/gpt-oss-20b"
# 先生役（直し・解説・質問）のモデル。未設定なら既定（Cloudflare は Gemma 4 26B、Groq は gpt-oss-120b）。使えなければ会話と同じモデル
# CLOUDFLARE_TUTOR_MODEL="@cf/google/gemma-4-26b-a4b-it"
# GROQ_TUTOR_MODEL="openai/gpt-oss-120b"

# ── アクセス制限（任意） ──
# 設定すると /api/*（health 以外）に X-App-Token ヘッダーが必要になる（アプリの設定画面で入力）
# APP_ACCESS_TOKEN="change-me-to-a-long-random-string"
